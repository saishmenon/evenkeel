{
  "name": "evenkeel-ui",
  "version": "1.1.0",
  "description": "Calm interfaces for dense data. A themeable design system for data-heavy web apps, in Figma and React.",
  "keywords": [
    "design-system",
    "react",
    "components",
    "ui",
    "figma",
    "design-tokens",
    "theming",
    "dark-mode",
    "accessibility",
    "wcag",
    "data-visualization",
    "charts",
    "dashboard",
    "storybook",
    "css-variables",
    "oklch",
    "tokens",
    "data-table",
    "light-dark",
    "figma-variables"
  ],
  "homepage": "https://github.com/saishmenon/evenkeel#readme",
  "bugs": {
    "url": "https://github.com/saishmenon/evenkeel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saishmenon/evenkeel.git"
  },
  "license": "MIT",
  "author": "Saish",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./icons": {
      "types": "./dist/types/icons/icons.d.ts",
      "import": "./dist/icons.js",
      "require": "./dist/icons.cjs"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/evenkeel.css"
    },
    "./evenkeel.css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/evenkeel.css"
    },
    "./tokens.css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/tokens.css"
    },
    "./fonts.css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/fonts.css"
    },
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "brand",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "npm run test:contrast && npm run test:parity",
    "build:tokens": "tsx scripts/build.ts",
    "test:contrast": "tsx scripts/check-contrast.ts",
    "storybook": "npm run build:tokens && storybook dev -p 6006",
    "build-storybook": "npm run build:tokens && npm run test:contrast && storybook build -o storybook-static",
    "typecheck": "tsc",
    "test:parity": "tsx scripts/check-figma-parity.ts",
    "test:a11y": "node scripts/check-a11y.mjs",
    "test:all": "npm run build-storybook && npm test && npm run test:a11y",
    "build": "npm run build:tokens && npm run build:lib",
    "build:lib": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && vite build -c vite.lib.config.ts",
    "test:smoke": "node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run build:tokens && npm run typecheck && npm test && npm run build:lib && npm run test:smoke",
    "gen:icons": "tsx scripts/gen-icons.ts",
    "gen:illustrations": "tsx scripts/gen-illustrations.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "culori": "^4.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/culori": "^4.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-static": "^1.54.0",
    "playwright": "^1.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
